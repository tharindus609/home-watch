# systemd *user* unit: install to ~/.config/systemd/user/ (see README).
# It must be a user unit for %h to mean your home directory — in a system unit
# systemd resolves %h to /root regardless of any User= setting.
[Unit]
Description=home-watch temperature/humidity Prometheus exporter

[Service]
Type=simple
WorkingDirectory=%h/home-watch
ExecStart=%h/.local/bin/uv run --frozen home-watch.py
Environment=HOME_WATCH_METRICS_PORT=9101
Environment=HOME_WATCH_INTERVAL=15
Restart=always
RestartSec=5
NoNewPrivileges=yes

[Install]
WantedBy=default.target
