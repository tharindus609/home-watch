[Unit]
Description=home-watch temperature/humidity Prometheus exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# GPIO bit-banging needs root for /dev/mem and stable timing.
User=root
WorkingDirectory=/home/pi/src/home-watch
Environment=HOME_WATCH_PIN=12
Environment=HOME_WATCH_METRICS_PORT=9101
Environment=HOME_WATCH_INTERVAL=15
ExecStart=/usr/local/bin/uv run --frozen home-watch.py
Restart=always
RestartSec=5
# Nice the process down slightly: the driver busy-waits while sampling.
Nice=5

[Install]
WantedBy=multi-user.target
